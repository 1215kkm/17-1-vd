<Window x:Class="BitcoinPredictor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:vm="clr-namespace:BitcoinPredictor.ViewModels"
        Title="비트코인 주간 예측 시스템"
        Height="900" Width="1400"
        MinHeight="700" MinWidth="1000"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="5,5,5,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="₿" FontSize="40" Foreground="{StaticResource PrimaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="비트코인 주간 예측 시스템" FontSize="24"
                                   Foreground="{StaticResource TextBrush}" FontWeight="Bold"/>
                        <TextBlock Text="3년간 패턴 분석 기반 AI 예측" FontSize="12"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="현재 가격: " FontSize="14" Foreground="{StaticResource SubTextBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CurrentPrice}" FontSize="28"
                               Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 예측 결과 카드들 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 예측 방향 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="이번 주 예측" FontSize="14" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PredictionDirection}" FontSize="32" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 확률 -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="예측 확률" FontSize="14" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PredictionProbability}" FontSize="32" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 신뢰도 -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="신뢰도" FontSize="14" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding PredictionConfidence}" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 기술적 지표 -->
            <Border Grid.Column="3" Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="기술적 지표" FontSize="14" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding RsiValue}" FontSize="14" Foreground="{StaticResource TextBrush}"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding SmaStatus}" FontSize="11" Foreground="{StaticResource SubTextBrush}"
                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 메인 컨텐츠 -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 왼쪽: 차트 + 패턴 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 가격 차트 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="비트코인 가격 차트 (최근 90일)"
                                   FontSize="16" Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <lvc:CartesianChart Grid.Row="1"
                                           Series="{Binding PriceSeries}"
                                           XAxes="{Binding XAxes}"
                                           YAxes="{Binding YAxes}"
                                           ZoomMode="X"
                                           TooltipPosition="Top">
                            <lvc:CartesianChart.Background>
                                <SolidColorBrush Color="#1E1E1E"/>
                            </lvc:CartesianChart.Background>
                        </lvc:CartesianChart>
                    </Grid>
                </Border>

                <!-- 패턴 분석 테이블 -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="5,10,5,5" MaxHeight="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="패턴 분석 결과"
                                   FontSize="16" Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Patterns}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  Foreground="{StaticResource TextBrush}"
                                  BorderThickness="0"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  RowBackground="#252525"
                                  AlternatingRowBackground="#1E1E1E">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#333333"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="패턴" Binding="{Binding PatternName}" Width="120"/>
                                <DataGridTextColumn Header="설명" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="상승확률" Binding="{Binding UpProbability, StringFormat={}{0:F1}%}" Width="80"/>
                                <DataGridTextColumn Header="신뢰도" Binding="{Binding Confidence, StringFormat={}{0:F0}%}" Width="70"/>
                                <DataGridCheckBoxColumn Header="일치" Binding="{Binding IsCurrentlyMatched}" Width="50"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 오른쪽: 예측 상세 + 버튼 -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 예측 이유 -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="예측 상세"
                                   FontSize="16" Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <TextBlock Grid.Row="1" Text="{Binding PredictionSummary}"
                                   FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,15"/>

                        <ListBox Grid.Row="2" ItemsSource="{Binding Reasons}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                               Margin="0,3" FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 백테스트 결과 -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="5,10,5,5">
                    <StackPanel>
                        <TextBlock Text="백테스트 (과거 검증)" FontSize="14"
                                   Foreground="{StaticResource TextBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding BacktestResult}" FontSize="12"
                                   Foreground="{StaticResource SubTextBrush}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 버튼들 -->
                <StackPanel Grid.Row="2" Margin="5,10,5,5">
                    <Button Content="🔄 데이터 새로고침" Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,0,10"/>
                    <Button Content="📊 백테스트 실행" Command="{Binding BacktestCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Background="#333333"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 상태바 -->
        <Border Grid.Row="3" Background="#252525" CornerRadius="5" Padding="15,10" Margin="5,10,5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="{Binding IsLoading}" Width="100" Height="3"
                                 Margin="15,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding LastUpdate}" FontSize="11"
                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- 로딩 오버레이 -->
        <Border Grid.RowSpan="4" Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="데이터 분석 중..." Foreground="White" FontSize="14"
                           Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
</Window>
